{
  "$schema": "https://specsfy.dev/brand/tokens.schema.json",
  "name": "specsfy",
  "note": "Fonte normativa: brand/colors/palette.md. O logo usa somente black e white.",
  "primitive": {
    "black": { "value": "#000000", "usage": "Camadas do logo, títulos e texto principal no modo claro" },
    "white": { "value": "#FFFFFF", "usage": "Código do logo, placa segura e texto principal no modo escuro" },
    "graphite": { "value": "#171717", "usage": "Fundo escuro de interface; não substitui o preto do logo" },
    "fog": { "value": "#F5F5F5", "usage": "Superfície elevada clara" },
    "gray500": { "value": "#737373", "usage": "Texto secundário no modo claro" },
    "gray400": { "value": "#A3A3A3", "usage": "Texto secundário no modo escuro" }
  },
  "semantic": {
    "paper": { "light": "#FFFFFF", "dark": "#171717" },
    "paperElevated": { "light": "#F5F5F5", "dark": "#262626" },
    "ink": { "light": "#000000", "dark": "#FFFFFF" },
    "inkSecondary": { "light": "#737373", "dark": "#A3A3A3" },
    "border": { "light": "#D4D4D4", "dark": "#404040" },
    "link": { "light": "#1D4ED8", "dark": "#93C5FD" },
    "verified": { "light": "#047857", "dark": "#6EE7B7" },
    "draft": { "light": "#92400E", "dark": "#FCD34D" },
    "red": { "light": "#B91C1C", "dark": "#FCA5A5" }
  }
}
