{
  "name": "@promovaweb/specsfy",
  "version": "0.7.0",
  "description": "CLI e TUI do Specsfy para instalar skills e acompanhar especificações.",
  "license": "MIT",
  "homepage": "https://github.com/promovaweb/specsfy",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/promovaweb/specsfy.git",
    "directory": "cli"
  },
  "bugs": {
    "url": "https://github.com/promovaweb/specsfy/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "bin": {
    "specsfy": "bin/specsfy.cjs"
  },
  "main": "dist/cli.js",
  "types": "dist/cli.d.ts",
  "files": [
    "bin/specsfy.cjs",
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.json",
    "build:executable": "node scripts/build-executable.mjs",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build && npm run build:executable && npm pack --dry-run"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "marked": "^15.0.12",
    "marked-terminal": "^7.3.0",
    "neo-blessed": "^0.2.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.27",
    "@types/node": "^24.10.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
